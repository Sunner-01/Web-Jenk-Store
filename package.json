{
  "name": "voltio-store",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint src tests --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "jest --runInBand",
    "test:ci": "jest --ci --runInBand --coverage",
    "deploy:local": "node scripts/deploy.mjs",
    "check": "npm run lint && npm run typecheck && npm run test:ci && npm run build"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "lucide-react": "^0.468.0",
    "@fontsource/manrope": "^5.2.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/jest": "^30.0.0",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.0.0",
    "jest-junit": "^16.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0"
  },
  "engines": { "node": ">=22.14.0" }
}
